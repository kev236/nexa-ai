{
  "name": "nexa-ai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "node --env-file-if-exists=.env node_modules/.bin/vitest run",
    "typecheck": "tsc -b --noEmit && tsc -p packages/permission-engine/tsconfig.test.json",
    "lint": "eslint .",
    "check:boundaries": "node tools/import-boundary/check.mjs",
    "db:migrate": "node --env-file-if-exists=.env packages/permission-engine/db/migrate.mjs",
    "db:seed": "node --env-file-if-exists=.env packages/permission-engine/db/seed.mjs",
    "db:create-owner": "node --env-file-if-exists=.env packages/permission-engine/db/createOwner.mjs",
    "db:backfill-nexalabs": "npm run build:permission-engine && node --env-file-if-exists=.env packages/permission-engine/db/backfillNexaLabs.mjs",
    "db:register-agent": "node --env-file-if-exists=.env packages/permission-engine/db/registerAgent.mjs",
    "db:register-business": "node --env-file-if-exists=.env packages/permission-engine/db/registerBusiness.mjs",
    "db:set-business-config": "node --env-file-if-exists=.env packages/permission-engine/db/setBusinessConfig.mjs",
    "db:set-agent-autonomy": "node --env-file-if-exists=.env packages/permission-engine/db/setAgentAutonomy.mjs",
    "db:run-waitlist-triage": "npm run build:permission-engine && node --env-file-if-exists=.env packages/permission-engine/db/runWaitlistTriage.mjs",
    "db:run-transaction-review": "npm run build:permission-engine && node --env-file-if-exists=.env packages/permission-engine/db/runTransactionReview.mjs",
    "db:import-campaign": "npm run build:permission-engine && node --env-file-if-exists=.env packages/permission-engine/db/importCampaign.mjs",
    "db:generate-concepts": "npm run build:permission-engine && node --env-file-if-exists=.env packages/permission-engine/db/generateConcepts.mjs",
    "build:permission-engine": "npm run build --workspace=packages/permission-engine",
    "dashboard:dev": "npm run dev --workspace=packages/dashboard",
    "dashboard:build": "npm run build --workspace=packages/dashboard"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "^10.10.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
