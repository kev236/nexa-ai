# Copy this file to .env and fill in real values. Never commit .env.
# Per this project's standing rules: no secrets in the repo, ever.

# Postgres connection string for @nexa-ai/permission-engine's own audit
# log and approval persistence (packages/permission-engine/src/db.ts).
# Required by `npm run db:migrate` / `npm run db:seed`, and by the
# Postgres-backed stores (createPostgresAuditLogStore /
# createPostgresApprovalStore). Not required for tests, which default to
# the in-memory stores unless TEST_DATABASE_URL is also set.
DATABASE_URL=postgres://user:password@localhost:5432/nexa_ai_dev

# Separate database for the Postgres-backed store tests
# (packages/permission-engine/test/postgresStore.test.ts). Kept distinct
# from DATABASE_URL so running tests never touches dev data. Unset ->
# those tests skip rather than fail.
TEST_DATABASE_URL=postgres://user:password@localhost:5432/nexa_ai_test

# Signs the dashboard's session cookie (packages/dashboard/src/lib/session.ts).
# Generate one with: openssl rand -base64 32
# Rotating this invalidates every signed-in session immediately.
SESSION_SECRET=

# NexaLabsAdapter (packages/permission-engine/src/adapters/nexaLabsAdapter.ts)
# — read-only access to nexalabs.tech's Sanity project. Find these in that
# repo's own Sanity project settings (sanity.io/manage), not this repo —
# nexa-ai never shares credentials with nexalabs, per its own readme.
# SANITY_READ_TOKEN is only needed if the dataset isn't public.
SANITY_PROJECT_ID=
SANITY_DATASET=
SANITY_READ_TOKEN=

# Step 33's Blog Agent (packages/permission-engine/src/executors/
# createBlogPostDraft.ts) — write access to create *draft* nexalabs.tech
# blog posts, deliberately separate from SANITY_READ_TOKEN above (least
# privilege: this token can write, the read one above can't). Without
# this set, 'create_blog_post_draft' just stays unregistered — same
# "missing env vars is expected" shape as every other executor.
SANITY_WRITE_TOKEN=

# Step 5's waitlist-triage agent (packages/permission-engine/src/llm/,
# src/agents/waitlistTriageAgent.ts) — calls Claude to draft replies.
# Since step 18, a draft sends the moment it's generated — see that
# step's README section — money is the only action type that still
# waits on an owner decision.
# Step 14's transaction-review agent (src/agents/transactionReviewAgent.ts),
# step 16's Campaign/Creative Agents (src/agents/campaignAgent.ts,
# creativeAgent.ts), step 17's Opportunity Discovery Agent
# (src/agents/opportunityDiscoveryAgent.ts), and step 19's Story Concept
# Agent (src/agents/storyConceptAgent.ts) share this same key — one
# model client, per this project's own "model choice is a routing
# decision made in one place" convention.
ANTHROPIC_API_KEY=

# Step 6's send_email executor (packages/permission-engine/src/executors/sendEmail.ts)
# — the first real execute capability. Approving a send_email decision
# now actually sends the email via Resend. Also requires the business's
# config.emailFrom to be set (npm run db:set-business-config -- <slug> '{"emailFrom":"..."}').
# Step 10 (src/notifications/emailNotifier.ts) reuses this same key to
# email every owner when something needs their approval — optional,
# same as the executor: without it, no notifications, everything else
# still works.
RESEND_API_KEY=

# Step 7's read-only Stripe view (NexaLabsAdapter.listTransactions(),
# packages/permission-engine/src/adapters/nexaLabsAdapter.ts) — lists
# charges/refunds/payouts into the `transactions` table for
# observability. Optional: without it, everything else still works,
# listTransactions() just isn't available (unless the crypto wallet
# pair below is set instead). Use nexalabs' TEST MODE secret key here,
# never a live one — see docs/plan-001-foundations.md.
STRIPE_SECRET_KEY=

# Step 7's read-only crypto wallet view (also NexaLabsAdapter.listTransactions())
# — an alternative/addition to Stripe: watches WALLET_ADDRESS on Ethereum
# mainnet for incoming/outgoing USDC transfers via the Etherscan API.
# Both must be set together; either can be set without the other pair
# above. Get a free API key at etherscan.io/apis.
ETHERSCAN_API_KEY=
WALLET_ADDRESS=

# Step 8's scheduled poll + triage route (packages/dashboard/src/app/api/cron/poll/route.ts)
# — Vercel Cron calls this on the schedule in packages/dashboard/vercel.json,
# sending it as `Authorization: Bearer <value>`. Generate one with:
# openssl rand -base64 32. Without this set, the route refuses every
# request (including Vercel's own), so it must be set on Vercel too —
# Project Settings > Environment Variables — not just locally.
CRON_SECRET=

# Step 9's Sanity webhook (packages/dashboard/src/app/api/webhooks/sanity/route.ts)
# — reacts to a new waitlist/contact document immediately instead of
# waiting for the next poll. Generate one with: openssl rand -base64 32,
# set it here AND as the webhook's own secret in the nexalabs Sanity
# project (sanity.io/manage → API → Webhooks) — see that route file's
# top comment for the full webhook configuration (URL, filter,
# projection). Optional: without it, events still arrive via the daily
# poll, just slower.
SANITY_WEBHOOK_SECRET=

# Step 24's YouTube follower sync (db/syncYouTubeFollowers.mjs,
# src/adapters/youtubeAdapter.ts) — fetches a channel's real subscriber
# count via YouTube Data API v3's channels.list, using an API key only
# (subscriber counts on a public channel are public data, so no OAuth
# consent flow is needed for this read-only piece — a future publish/
# upload capability would need one). Get a free key at
# console.cloud.google.com: enable "YouTube Data API v3" under APIs &
# Services, then Credentials → Create Credentials → API Key → "Public
# data" when asked what you're accessing.
YOUTUBE_API_KEY=

# Step 25's YouTube OAuth flow (packages/dashboard/src/app/api/oauth/youtube/,
# src/adapters/... once a publish executor exists) — grants real write
# access (uploading a video) to a connected YouTube channel, unlike
# YOUTUBE_API_KEY above which only reads public data. From the same
# Google Cloud project: APIs & Services → Credentials → Create
# Credentials → OAuth client ID → Web application. Add this deployment's
# domain to Authorized JavaScript origins, and
# <that domain>/api/oauth/youtube/callback to Authorized redirect URIs
# (must match YOUTUBE_OAUTH_REDIRECT_URI below exactly). Also needs the
# OAuth consent screen configured (External, privacy policy URL =
# https://nexalabs.tech/privacy-policy, scope youtube.upload) with the
# owner added as a test user — uploads stay Private-only until Google's
# app verification passes (required for Public uploads, not optional).
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REDIRECT_URI=

# Step 26's dropshipping business (db:register-business dropshipping "...")
# — src/adapters/shopifyAdapter.ts, GraphQL Admin API only (Shopify's
# REST Admin API went legacy in October 2024). As of January 1, 2026,
# Shopify retired the old "reveal a static token once" custom-app flow
# entirely — a new app only gets a Client ID + Client Secret, exchanged
# programmatically for a short-lived (24h) access token via the client
# credentials grant (see createShopifyHttpClient's own comment for the
# exact request shape). To get these three values: in the store's admin,
# go to Settings → Apps and sales channels → Develop apps (this now
# routes through "Build apps using Dev Dashboard", or open
# dev.shopify.com/dashboard directly) → Create an app → on its Access
# scopes step select read_orders and read_products → Install app on
# this store → the app's own Settings → Credentials has the Client ID
# and Client secret. Note: the client credentials grant only works when
# the app and the store are in the same Shopify organization in the Dev
# Dashboard — a `shop_not_permitted` error at runtime means they aren't.
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Step 27/29's TikTok posting (src/adapters/tiktokAdapter.ts,
# tiktokUploadAdapter.ts) — client_key + client_secret from a registered
# TikTok for Developers app (developers.tiktok.com), Login Kit ->
# Content Posting API products added, redirect URI set to
# <that domain>/api/oauth/tiktok/callback (must match
# TIKTOK_OAUTH_REDIRECT_URI below exactly), scopes user.info.basic +
# video.publish + video.upload enabled. IMPORTANT: the exact scope
# names, authorize-endpoint params, and Content Posting API request/
# response shapes were built from cross-checked third-party guides, not
# TikTok's own docs (developers.tiktok.com is blocked by this sandbox's
# network egress) — verify against TikTok's real docs or a real test
# post before trusting this, see tiktokAdapter.ts / tiktokUploadAdapter.ts's
# own comments. Also: an unaudited API client is forced to SELF_ONLY
# (private) posts, max 5 users/24h, and the TikTok account itself must
# be set to private — TikTok's own audit process lifts that, same shape
# as YouTube's verification gate.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_OAUTH_REDIRECT_URI=

# Step 29's Instagram posting (src/adapters/instagramAdapter.ts) — a
# Meta app (developers.facebook.com) with Facebook Login + the
# Instagram Graph API products added (NOT "Instagram API with Instagram
# Login" — that lighter flow doesn't support publishing at all, per
# third-party 2026 guides cross-checked at write time). Needs: a
# Facebook Page linked to an Instagram Professional (Business/Creator)
# account, App ID + App Secret from the app's Settings -> Basic, and
# this deployment's <domain>/api/oauth/instagram/callback added as a
# valid OAuth redirect URI (must match INSTAGRAM_OAUTH_REDIRECT_URI
# below exactly). Real production use (posting for accounts beyond the
# app's own registered testers) needs Meta's App Review for the
# instagram_content_publish permission — Meta's process, not something
# this code can shortcut, same shape as YouTube's verification gate.
# Like TikTok above, the exact scope names and Graph API request/
# response shapes here are sourced from cross-checked third-party
# guides, not developers.facebook.com directly (also blocked by this
# sandbox's network egress) — verify on first real use, see
# instagramAdapter.ts's own comment.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_OAUTH_REDIRECT_URI=

# The self-improvement agent (tools/propose-improvement/run.mjs, `npm run
# propose-improvement`) — finds its own target, edits real files, and
# opens a pull request. It never merges or pushes to main; GITHUB_TOKEN
# only needs to create branches/PRs (a fine-grained PAT scoped to this
# one repo, Contents: Read and write + Pull requests: Read and write —
# not a classic token with full `repo` scope). GITHUB_REPOSITORY is
# "owner/repo", e.g. "kev236/nexa-ai".
GITHUB_TOKEN=
GITHUB_REPOSITORY=
